# Copy to deploy/.env. Generate secrets with tools/configure_deployment.py.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
MQTT_PUBLIC_PORT=8883
MQTT_CONFIG=mosquitto.conf
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_SECURE_COOKIES=0
POSTGRES_DB=inventory
POSTGRES_USER=inventory
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
MQTT_USERNAME=inventory-server
MQTT_SERVER_CLIENT_ID=inventory-server
MQTT_HOST=127.0.0.1
MQTT_PORT=8883
MQTT_PASSWORD=
MQTT_TLS=1
MQTT_CA=/certs/ca.crt
HARDWARE_ENABLED=0
