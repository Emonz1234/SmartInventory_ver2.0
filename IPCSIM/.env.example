DEVICE_ID=IPCSIM01
DEVICE_TYPE=IPCSIM
APP_NAME=Smart Inventory Edge
HARDWARE_ENABLED=false
SERVER_URL=http://localhost:8080
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8000
DB_PATH=runtime/IPCSIM01.sqlite3
EDGE_API_TOKEN=replace-with-random-local-api-token
SERIAL_PORT=
# Optional JSON map: each group uses its own COM pair; leave SERIAL_PORT empty.
# SERIAL_GROUP_PORTS={"1":"COM2","2":"COM4"}
SERIAL_GROUP_PORTS={}
SERIAL_BAUDRATE=9600
# Maintenance attention only; these thresholds do not block device operations.
REPEATED_FAULT_THRESHOLD=3
REPEATED_FAULT_WINDOW_MINUTES=30
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA=
MQTT_PASSWORD=
