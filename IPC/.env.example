DEVICE_ID=IPC01
DEVICE_TYPE=IPC
APP_NAME=Smart Inventory Edge
SERIAL_GROUP_PORTS={}
HARDWARE_ENABLED=false
# Set true to receive current ESP32 USB telemetry; commands remain unsupported.
SERVER_URL=http://localhost:8080
EDGE_API_HOST=127.0.0.1
EDGE_API_PORT=8002
DB_PATH=runtime/IPC01.sqlite3
EDGE_API_TOKEN=replace-with-random-local-api-token
SERIAL_PORT=
# USB Serial used by esp32_master_serial (Serial2 output is currently disabled).
SERIAL_BAUDRATE=115200
MQTT_HOST=
MQTT_PORT=8883
MQTT_TLS=true
MQTT_CA=
MQTT_PASSWORD=
